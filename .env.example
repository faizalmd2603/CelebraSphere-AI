# CelebraSphere AI - Environment Variables
# Copy this file to .env or .env.local to configure live Google Gemini API endpoints.
# DO NOT COMMIT YOUR LIVE API KEYS TO PUBLIC REPOSITORIES.

# Primary Google Gemini API Key (Key 1)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Secondary & Rotation Fallback Keys (Optional failover pool)
VITE_GEMINI_API_KEY_BACKUP_1=
VITE_GEMINI_API_KEY_BACKUP_2=
VITE_GEMINI_API_KEY_BACKUP_3=
VITE_GEMINI_API_KEY_BACKUP_4=

# Preferred Gemini Model ID
# Supported models: gemini-3.8-flash, gemini-3.5-flash, gemini-2.5-flash-lite, gemini-3.1-pro-preview
VITE_GEMINI_MODEL=gemini-3.8-flash
VITE_GEMINI_FALLBACK_MODEL=gemini-3.5-flash
